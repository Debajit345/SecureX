# The anon key is safe to use only with the included RLS policies; keep it in server config.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
SECUREX_ADMIN_USER_ID=your-supabase-auth-user-uuid
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=workers-ai-api-token
